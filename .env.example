# Database (Supabase): set up in Step 2
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE"
DIRECT_URL=

# Authentication (NextAuth v5): set up in Step 3
AUTH_SECRET=  # node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_URL=
AUTH_GOOGLE_ID="<client ID>.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET=
AUTH_TRUST_HOST=""        # true for local dev; Vercel sets this automatically

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="SpendSense <onboarding@resend.dev>"

# AI (Anthropic Claude API): set up in Step 5
ANTHROPIC_API_KEY=

APP_URL="http://localhost:3000"

#Cron Secret
CRON_SECRET=""            # node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Analytics (only load after cookie consent)
NEXT_PUBLIC_VERCEL_ANALYTICS=""       # true to enable Vercel Web Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=""      # e.g. G-XXXXXXXXXX
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""       # e.g. spendsense.app
